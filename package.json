{
  "name": "agora-rtc-nextjs-quickstart",
  "version": "0.1.0",
  "private": true,
  "description": "Agora RTC Web one-to-one video calling quickstart for Next.js",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run doctor && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "agora-rtc-react": "2.5.1",
    "agora-token": "2.0.5",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.2",
    "postcss": "8.5.8",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
